[
  {
    "kernelSource": {
      "name": "SuiKernelNethunter",
      "repo": "https://github.com/LoggingNewMemory/SuiKernel-android12-5.10.git",
      "branch": "suikernel-stable",
      "device": "rock"
    },
    "defconfig": "gki_defconfig",
    "withKernelSU": true,
    "toolchains": [
      {
        "repo": "https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86",
        "branch": "master-kernel-build-2022",
        "name": "clang"
      }
    ],
    "params": {
      "ARCH": "arm64",
      "CC": "clang",
      "LLVM": ["1"],
      "LLVM_IAS": ["1"],
      "CROSS_COMPILE": "aarch64-linux-gnu-",
      "CROSS_COMPILE_COMPAT": "arm-linux-gnueabi-"
    }
  }
]
